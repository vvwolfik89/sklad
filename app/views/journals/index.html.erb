<h1>Журналы</h1>

<div class="mb-3">
  <%= link_to "Создать новый журнал", new_journal_path, class: "btn btn-primary" %>
</div>
<%= render 'shared/versions_modal' %>
<table class="table table-striped">
  <thead>
  <tr>
    <th>Название</th>
    <th>Описание</th>
    <th>Записи</th>
    <th>Действия</th>
  </tr>
  </thead>
  <tbody>
  <% @journals.each do |journal| %>
    <tr>
      <td><%= link_to journal.title, journal %></td>
      <td><%= journal.description %></td>
      <td><%= journal.entries.count %></td>
      <td>
        <%= link_to "Просмотр", journal_path(journal), class: "btn btn-sm btn-primary" if can?(:show, journal) %>
        <%= link_to "Исправить", edit_journal_path(journal), class: "btn btn-sm btn-secondary" if can?(:edit, journal) %>
        <%= link_to "Удалить", journal_path(journal), data: { turbo_method: :delete, turbo_confirm: "Удалить сборку?" }, class: "btn btn-sm btn-danger" if can?(:destroy, journal) %>
        <%= link_to("История изменений", nil, data: { bs_target: "#versionModal",
                                                      action: "click->version-modal#show",
                                                      version_modal_url: "#{version_history_journal_path(journal) }",
                                                      bs_toggle: "modal"
        }, class: "btn btn-info btn-block pv10 fw600 mb10") %>
      </td>
    </tr>
  <% end %>
  </tbody>
</table>
