<h1><%= @journal.title %></h1>
<p><%= @journal.description %></p>

<div class="mb-3">
  <%= link_to "Добавить запись", new_journal_entry_path(@journal), class: "btn btn-success" %>
  <%= link_to "Назад к списку", journals_path, class: "btn btn-secondary" %>
</div>

<h3>Записи</h3>
<% if @entries.any? %>
  <table class="table table-hover">
    <thead>
    <tr>
      <th>Дата</th>
      <th>Автор</th>
      <th>Действия</th>
    </tr>
    </thead>
    <tbody>
    <% @entries.each do |entry| %>
      <tr>
        <td><%= entry.date %></td>
        <td><%= entry.creator.full_name %></td>
        <td>
          <%= link_to "Посмотреть", [:journal, entry], class: "btn btn-sm btn-outline-info" %>
        </td>
      </tr>
    <% end %>
    </tbody>
  </table>
<% else %>
  <p>Нет записей. <%= link_to "Добавить первую", new_journal_entry_path(@journal) %>.</p>
<% end %>
