<h1>Журналы</h1>

<div class="mb-3">
  <%= link_to "Создать новый журнал", new_journal_path, class: "btn btn-primary" %>
</div>

<table class="table table-striped">
  <thead>
  <tr>
    <th>Название</th>
    <th>Описание</th>
    <th>Записи</th>
    <th>Действия</th>
  </tr>
  </thead>
  <tbody>
  <% @journals.each do |journal| %>
    <tr>
      <td><%= link_to journal.title, journal %></td>
      <td><%= journal.description %></td>
      <td><%= journal.entries.count %></td>
      <td>
        <%= link_to "Просмотр", journal, class: "btn btn-sm btn-outline-primary" %>
        <%= link_to "Добавить поле", new_journal_field_path(journal), class: "btn btn-sm btn-outline-secondary" %>
      </td>
    </tr>
  <% end %>
  </tbody>
</table>
