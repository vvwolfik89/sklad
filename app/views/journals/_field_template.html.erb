  <div data-controller="field-type" class="nested-field border rounded p-4 mb-3 bg-white shadow-sm">
    <!-- Скрытое поле ID (нужно для обновления существующих записей) -->

    <%= field_form.hidden_field :id %>

    <!-- Строка с основными настройками поля -->
    <div class="row g-3">
      <!-- Название поля -->
      <div class="col-md-6">
        <div class="field">
          <%= field_form.label :name, "Название", class: "form-label required" %>
          <%= field_form.text_field :name,
                                    class: "form-control",
                                    placeholder: "Например: 'ФИО клиента', 'Дата поставки'" %>
        </div>
      </div>

      <!-- Тип поля -->
      <div class="col-md-4">
        <div class="field">
          <%= field_form.label :field_type, "Тип", class: "form-label required" %>
          <%#= field_form.select :field_type, Field.field_type_options, { include_blank: "Выберите тип поля" },                      class: "form-select" %>

          <%= field_form.select :field_type, Field.field_types.keys.map { |k| [k.humanize, k] },
                                { include_blank: false },
                                { class: "form-select",
                                  data: { action: "change->field-type#toggleSections" }
                                } %>
        </div>
      </div>


      <!-- Секция для полей-ссылок (user_select, car_select) -->
      <div data-field-type-target="relatedSection" class="d-none mb-3">
        <div>
          <%= field_form.label :related_model, "Связанная модель" %>
          <%= field_form.text_field :related_model, { class: "form-control", disabled: true , data: {field_type_target: "relatedModel" }} %>
        </div>
        <div>
          <%= field_form.label :display_field, "Поле для отображения" %>
          <%= field_form.text_field :display_field,  { class: "form-control", placeholder: "Например: full_name", data: {field_type_target: "displayField" } }%>
        </div>
      </div>

      <!-- Секция для select-полей -->
      <div data-field-type-target="optionsSection" class="d-none mb-3">
        <div>
          <%= field_form.label :options, "Варианты (через запятую)" %>
          <%= field_form.text_area :options, class: "form-control", rows: 2 %>
        </div>
      </div>

      <!-- Обязательность -->
      <div class="col-md-2 d-flex align-items-end">
        <div class="field form-check">
          <%= field_form.check_box :required,
                                   class: "form-check-input",
                                   id: "field_required_#{field_form.object.id || 'new'}" %>
          <%= field_form.label :required, "Обязательно",
                               class: "form-check-label",
                               for: "field_required_#{field_form.object.id || 'new'}" %>
        </div>
      </div>
    </div>

    <!-- Подсказка (placeholder) -->
    <div class="field mt-3">
      <%= field_form.label :placeholder, "Подсказка (опционально)", class: "form-label text-secondary" %>
      <%= field_form.text_field :placeholder,
                                class: "form-control",
                                placeholder: "Текст, который будет виден в поле до ввода данных" %>
    </div>

    <!-- Кнопка удаления (только для существующих полей) -->
    <% if field_form.object.persisted? %>
      <div class="mt-3 pt-2 border-top">
        <div class="form-check">
          <%= field_form.check_box :_destroy,
                                   class: "form-check-input",
                                   id: "destroy_field_#{field_form.object.id}" %>
          <%= field_form.label :_destroy, "Удалить это поле",
                               class: "form-check-label text-danger",
                               for: "destroy_field_#{field_form.object.id}" %>
        </div>
      </div>
    <% end %>
  </div> <!-- /.nested-field -->
