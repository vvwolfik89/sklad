<div class="row">
  <div class="col-md-12">
    <div class="panel">
      <div class="panel-heading">
        <span class="panel-title"><%= @permission.name || "Разрешение" %></span>
      </div>
      <div class="panel-body">
        <%= custom_form_for(@permission, bootstrap3_form_options) do |f| %>
          <%= f.error_notification %>
          <%= f.input :name %>
          <%= f.input :action_name %>
          <%= f.input :class_name %>
          <%= f.input :description %>
          <div class="col-sm-offset-3 p-3">
            <%= f.input :is_active %>
          </div>
          <div class="col-sm-offset-3 p-3">
            <%= f.button :submit, "Сохранить", class: "btn-primary btn-block" %>
            <%= link_to("Все разрешения", permissions_path, class: "btn btn-dark btn-block") %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
