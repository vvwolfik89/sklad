<div class="card mb-3">
  <div class="row g-0">
    <%= content_for :breadcrumbs do %>
      <li class="crumb-link">
        <%= link_to("Roles", roles_path) %>
      </li>
      <li class="crumb-trail">
        <%= @role.title %>
      </li>
    <% end %>
  </div>

  <div class="col-md-12">
    <div class="card-body">
      <table class="table table-bordered table-striped">
        <tbody>
        <tr>
          <td><span class="panel-title"><%= @role.title %></span></td>
          <td>
            <h5 class="card-title"><%= @role.description %></h5>
            <p class="card-text"><%= @role.permissions.pluck(:description).join("; ") %></p>
          </td>
        </tr>
        </tbody>
      </table>
      <div class="mb15">
        <%= link_to("Исправить", edit_role_path(@role), class: "btn btn-primary btn-block") if can?(:update, @role) %>
        <%= link_to("Удалить", role_path(@role), data: { turbo_method: :delete, confirm: "Are you sure?" }, class: "btn btn-danger btn-block") if can?(:destroy, @role) %>
        <%= link_to("Все роли", roles_path, class: "btn btn-block btn-dark pv10 fw600 mb10") %>
      </div>
    </div>
  </div>
</div>
</div>
