<%= form_with(model: @order_log, local: true) do |f| %>
  <div data-controller="order-log-form">
    <%= f.label :date, "Дата журнала" %>
    <%= f.date_field :date, required: true %>

    <div data-order-log-form-target="orderDetailsContainer">
      <!-- Рендерим все order_details через fields_for -->
      <%= f.fields_for :order_details do |ff| %>
        <%= render "order_detail_fields", f: ff %>
      <% end %>
    </div>

    <button type="button"
            data-action="click->order-log-form#addOrderDetail"
            class="btn btn-secondary mt-2">
      Добавить детали заказа
    </button>

    <%= f.submit class: "btn btn-primary mt-3" %>
    <!-- Шаблон для нового OrderDetail -->
    <template data-order-log-form-target="orderDetailTemplate">
      <%= fields_for :order_details, OrderDetail.new, child_index: "NEW_ORDER_DETAIL" do |ff| %>
        <%= render "order_detail_fields", f: ff %>
      <% end %>
    </template>
  </div>
<% end %>


