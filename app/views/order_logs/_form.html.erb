<div data-controller="order-details">
  <%= custom_form_for(@order_log, bootstrap3_form_options(html_class: "agent-form")) do |form| %>

    <% if @order_log.errors.present? %>
      <div class="alert alert-danger">
        <% @order_log.errors.full_messages.each do |msg| %>
          <p><%= msg %></p>
        <% end %>
      </div>
    <% end %>
    <%= form.date_field :date %>
    <!-- ... поля заказа ... -->

    <div data-order-details-target="container">
      <h3>Заказы</h3>
      <%= form.fields_for :order_details do |f| %>
        <%= render 'order_detail_fields', f: f %>
      <% end %>
    </div>

    <template data-order-details-target="template">
      <%= form.fields_for :order_details, OrderDetail.new, child_index: "new_order_details" do |f| %>
        <%= render 'order_detail_fields', f: f %>
      <% end %>
    </template>

    <%= link_to "➕ Добавить заказ", "#", data: { action: "click->order-details#add" }, class: "btn btn-success btn-block" %>

    <div class="row">
      <div class="col-sm-offset-3 col-sm-3 p-3">
        <%= form.submit "Save", class: "btn btn-primary btn-block" %>
        <%= link_to("Cancel", order_logs_path, class: "btn btn-dark btn-block") %>
      </div>
    </div>
  <% end %>
</div>