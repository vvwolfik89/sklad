<div class="row p-1">
  <div class="order_detail">
    <%= f.collection_select :partner_id, Partner.all, :id, :name %>
    <div>
      <div data-order-target="container">
        <h3>Заявки</h3>
        <%= f.fields_for :orders do |f| %>
          <%= render 'order_fields', f: f %>
        <% end %>
      </div>
      <template data-order-target="template">
        <%= f.fields_for :orders, Order.new, child_index: "new_orders" do |f| %>
          <%= render 'order_fields', f: f %>
        <% end %>
      </template>
      <%= link_to "➕ Добавить заявку", "#", data: { action: "click->order-details#add" }, class: "btn btn-success btn-block" %>
    </div>


    <%= f.hidden_field :_destroy %>
    <%= link_to "Удалить", "#", data: { action: "click->order-details#remove" }, class: "btn btn-danger btn-block remove_order_detail " %>
  </div>
</div>
