<%= render partial: "filter" %>

<%= content_for :breadcrumbs do %>
  <li class="crumb-trail">
    Заказы
  </li>
<% end %>

<div class="row">
  <div class="col-md-12">
    <div class="panel">
      <div class="panel-body pn">
        <div class="bs-component">
          <div class="col-md-6 mt20 mb20">
            <%= link_to("New", new_order_log_path, class: "btn btn-primary") if can?(:create, OrderLog) %>
            <%#= new_help_desk_link_helper('panel-campaign-new') %>
          </div>
          <% if @order_logs.empty? %>
            <div class="alert alert-info">
              По выбранной дате записей не найдено.
            </div>
          <% else %>
          <div class="col-md-6 text-right">
            <%= will_paginate @order_logs %>
          </div>
          <div class="col-md-12">
            <table class="table table-hover table-striped">
              <thead>
              <tr>
                <th>ID</th>
                <th>Дата</th>
<!--                <th>Company</th>-->
<!--                <th>Dialer CampID</th>-->
<!--                <th>Tags</th>-->
<!--                <th>Form Definition</th>-->
<!--                <th>Campaign Agent Hours</th>-->
<!--                <th>Actions</th>-->
              </tr>
              </thead>
              <tbody>
              <% @order_logs.each do |order_log| %>
                <tr>
                  <td><%= order_log.id %></td>
                  <td><%= order_log.date %></td>
<!--                  <td><%#= link_to(campaign.description, campaign_path(campaign)) %></td>-->
<!--                  <td><%#= campaign.try(:company).try(:company_name) || "N/A" %></td>-->
<!--                  <td><%#= campaign.dialier_campaign_id %></td>-->
<!--                  <td><%#= show_tag_list(campaign.tag_list) %></td>-->
<!--                  <td><%#= campaign.dynamic_form_definition.try(:name) %></td>-->
<!--                  <td><%#= campaign.daily_agents_hours %></td>-->
                  <td>
                    <%= link_to("Show", order_log_path(order_log), class: "btn btn-sm btn-primary") if can?(:show, order_log) %>
                    <%= link_to("Edit", edit_order_log_path(order_log), class: "btn btn-sm btn btn-secondary") if can?(:edit, order_log) %>
                    <%= link_to("Destroy", order_log_path(order_log), method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-sm btn-danger") if can?(:destroy, order_log) %>
                  </td>
                </tr>
              <% end %>
              </tbody>
            </table>
          </div>

          <div class="col-md-12 text-right">
            <%= will_paginate @order_logs %>
          </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>